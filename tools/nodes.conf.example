# Copy to tools/nodes.conf (not committed) and adjust.
# The SSH key is $VMS_SSH_KEY, default ~/.ssh/vms_ed25519.
# The VAX has no SSH, so it is not here: tools/vax.py in
# vms-site-config drives it over Telnet and FTP.
# name  arch    host           port  user      vms_workdir                    sftp_workdir
alpha   ALPHA   <alpha-host>   22    username  DISK$WORK:[USERNAME.VMSOTEL]   /DISK$WORK/USERNAME/vmsotel
ia64    IA64    <ia64-host>    22    username  USER$ROOT:[USERNAME.VMSOTEL]   /USER$ROOT/username/vmsotel
x86     X86_64  <x86-host>     22    username  USER$ROOT:[USERNAME.VMSOTEL]   /USER$ROOT/username/vmsotel
