# vmsotel configuration: key = value, one per line. Lines starting
# with # or ! are comments. Only host is required.

# The collector. Port 4318 is OTLP/HTTP; the test collector on
# docker-nuc also listens with TLS on 4319.
host = 192.168.0.218
port = 4318
# path = /v1/metrics

# TLS. The certificate is always verified: against cafile if given,
# otherwise the system's default CAs. A certificate for an address
# needs that address as an IP SAN, and host must be the address.
# tls = yes
# cafile = collector.crt

# Seconds between collections (1 to 86400).
interval = 60

# Seconds to wait for a connection, or for each read of a reply.
# timeout = 10

# Exports kept while the collector cannot be reached; when full, the
# oldest is dropped (1 to 64).
# queue = 10

# Largest payload, in bytes. A host with many disks may need more; the
# log says how much when it does.
# max_payload = 131072

# Extra resource attributes, sent with every export.
# resource.deployment.environment = lab

# Per-process metrics: processes chosen by name or username, VMS
# wildcards (* and %), case ignored, each up to 16 times. Other
# accounts' processes need WORLD; VMSOTEL_START.COM grants it only when
# a line here begins with process. -- commented out, as below, it does
# not.
# process.name = MARIADBD*
# process.user = LIGHTTPD

# Logs: the operator log and the security audit journal, sent as OTLP
# logs to logs.path. Both files need READALL, which VMSOTEL_START.COM
# grants only when one of these is yes. The agent starts at the end of
# each file: what was there before it started is not sent. OPCOM
# writes its log in batches, so operator messages arrive up to about a
# quarter of an hour late, each with the time OPCOM gave it.
# logs.opcom = yes
# logs.audit = yes
# logs.path = /v1/logs
# logs.opcom_file = SYS$MANAGER:OPERATOR.LOG
# logs.audit_file = SYS$MANAGER:SECURITY.AUDIT$JOURNAL
