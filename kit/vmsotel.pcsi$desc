--
-- PCSI product description for the vmsotel agent (issinoho/vmsotel).
-- MAKE_KIT.COM writes it out with @PRODUCER@, @BASE@ and @PCSIVERSION@
-- filled in, and gathers every file it names (tools/check_kit.py checks
-- that it does).
--
product @PRODUCER@ @BASE@ VMSOTEL @PCSIVERSION@ full ;

    -- VMSOTEL_TLS.EXE and VMSOTEL_LAUNCH.EXE link VSI's OpenSSL 3 shared
    -- images (SSL3$LIBSSL_SHR32, SSL3$LIBCRYPTO_SHR32).
    software VSI @BASE@ SSL3 ;

    information RELEASE_NOTES phase after ;

    directory [VMSOTEL] ;
    directory [VMSOTEL.BIN] ;
    directory [VMSOTEL.COM] ;
    directory [VMSOTEL.CONF] ;
    directory [VMSOTEL.DOC] ;
    directory [VMSOTEL.LOG] ;

    file [VMSOTEL.BIN]VMSOTEL.EXE ;
    file [VMSOTEL.BIN]VMSOTEL_TLS.EXE ;
    file [VMSOTEL.BIN]VMSOTEL_LAUNCH.EXE ;
    file [VMSOTEL.COM]VMSOTEL_START.COM ;
    file [VMSOTEL.COM]VMSOTEL_RUN.COM ;
    file [VMSOTEL.COM]VMSOTEL_STOP.COM ;
    file [VMSOTEL.COM]VMSOTEL_PRIVS.COM ;
    file [VMSOTEL.COM]VMSOTEL$CONFIGURE.COM ;
    file [VMSOTEL.CONF]VMSOTEL.CONF_EXAMPLE ;
    file [VMSOTEL.DOC]README.VMS ;
    file [VMSOTEL.DOC]OPERATIONS.MD ;
    file [VMSOTEL.DOC]LICENSE. ;
    file [SYS$STARTUP]VMSOTEL$STARTUP.COM ;
    file [SYS$STARTUP]VMSOTEL$SHUTDOWN.COM ;

    -- Define VMSOTEL$ROOT now. VMSOTEL.CONF and the logs are never part
    -- of the kit, so an upgrade or a removal leaves them alone.
    execute postinstall "@PCSI$DESTINATION:[SYS$STARTUP]VMSOTEL$STARTUP.COM INSTALL" interactive ;
    -- On removal: stop the agent, deassign VMSOTEL$ROOT and VMSOTEL$USER.
    execute install "CONTINUE" remove "@PCSI$DESTINATION:[SYS$STARTUP]VMSOTEL$STARTUP.COM REMOVE" ;

    information POST_INSTALL phase after ;

end product ;
